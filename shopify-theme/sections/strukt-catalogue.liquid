{{ 'strukt.css' | asset_url | stylesheet_tag }}
<script src="{{ 'strukt.js' | asset_url }}" defer></script>

{%- liquid
  assign source = section.settings.collection
  if source == blank
    assign source = collections.all
  endif
  assign products = source.products
  assign limit = section.settings.products_to_show

  assign type_str = ''
  for p in products limit: limit
    if p.type != blank
      assign needle = '||' | append: p.type
      unless type_str contains needle
        assign type_str = type_str | append: needle
      endunless
    endif
  endfor
  assign types = type_str | split: '||'
-%}

<div class="strukt" id="{{ section.settings.anchor | default: 'shop' | handle }}">
  <div class="strukt-topline">
    <div class="strukt-container strukt-section">
      <div class="strukt-section__head">
        <div>
          {%- if section.settings.kicker != blank -%}
            <span class="strukt-kicker">{{ section.settings.kicker }}</span>
          {%- endif -%}
          <h2 class="strukt-section__title">{{ section.settings.heading }}</h2>
        </div>

        {%- if section.settings.show_filters and types.size > 1 -%}
          <div class="strukt-seg" role="group" aria-label="Filter by product type" data-strukt-filters>
            <button type="button" class="strukt-seg__btn" aria-pressed="true" data-strukt-filter="*">
              {{ section.settings.filter_all_label }}
            </button>
            {%- for t in types -%}
              {%- unless t == blank -%}
                <button type="button" class="strukt-seg__btn" aria-pressed="false" data-strukt-filter="{{ t | escape }}">
                  {{ t }}
                </button>
              {%- endunless -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- if products.size > 0 -%}
        <div class="strukt-grid" data-strukt-grid>
          {%- for product in products limit: limit -%}
            {%- render 'strukt-product-card',
              product: product,
              grayscale: section.settings.grayscale,
              low_threshold: section.settings.low_stock_threshold,
              choose_label: section.settings.choose_label,
              sold_out_label: section.settings.sold_out_label,
              sold_out_url: section.settings.sold_out_url,
              add_label: section.settings.add_label
            -%}
          {%- endfor -%}
        </div>
      {%- else -%}
        <p>{{ section.settings.empty_text }}</p>

        {%- comment -%}
          Editor-only diagnosis. An empty catalogue is almost always a store
          setting, not a theme bug, so say which one rather than leaving the
          merchant to guess. request.design_mode is true only inside the theme
          editor, so a shopper never sees any of this.
        {%- endcomment -%}
        {%- if request.design_mode -%}
          {%- assign store_count = collections.all.all_products_count -%}
          <div class="strukt-diagnosis">
            <p class="strukt-diagnosis__title">Why this is empty — visible to you in the theme editor only</p>
            <ul>
              {%- if section.settings.collection != blank -%}
                <li>Source: collection &ldquo;{{ section.settings.collection.title }}&rdquo; — {{ source.all_products_count }} product(s) in it</li>
              {%- else -%}
                <li>Source: all products — {{ store_count }} published to the Online Store</li>
              {%- endif -%}
              <li>Products to show: {{ limit }}</li>
            </ul>

            {%- if store_count == 0 -%}
              <p>No product is published to the Online Store sales channel yet. Open a product in the admin, find <strong>Publishing</strong> (or <strong>Sales channels</strong>) and tick <strong>Online Store</strong>. Draft products never appear either — set the product to <strong>Active</strong>.</p>
            {%- elsif section.settings.collection != blank and source.all_products_count == 0 -%}
              <p>That collection holds no products, but the store has {{ store_count }} on the Online Store. Either clear the <strong>Collection</strong> setting on this section to show them all, or add the products to that collection in the admin.</p>
            {%- else -%}
              <p>The store has {{ store_count }} product(s) on the Online Store. If none reach this grid, check that this section's <strong>Collection</strong> setting points where you expect.</p>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Strukt catalogue",
  "tag": "section",
  "class": "strukt-section-catalogue",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Leave empty to show all products." },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 2, "max": 24, "step": 1, "default": 8 },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "New this week" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The catalogue" },
    { "type": "text", "id": "anchor", "label": "Anchor id", "info": "Used by in-page links such as #shop.", "default": "shop" },
    { "type": "header", "content": "Filters" },
    { "type": "checkbox", "id": "show_filters", "label": "Filter by product type", "default": true },
    { "type": "text", "id": "filter_all_label", "label": "\"All\" label", "default": "All" },
    { "type": "header", "content": "Cards" },
    { "type": "checkbox", "id": "grayscale", "label": "Grayscale photos", "default": true },
    { "type": "range", "id": "low_stock_threshold", "label": "Low stock threshold", "min": 1, "max": 20, "step": 1, "default": 3 },
    { "type": "text", "id": "add_label", "label": "Add to cart label", "default": "Add to cart" },
    { "type": "text", "id": "choose_label", "label": "Multi-option label", "info": "Products with sizes or colours link to their page instead of quick-adding.", "default": "Choose a size" },
    { "type": "text", "id": "sold_out_label", "label": "Sold out label", "default": "Notify me" },
    { "type": "url", "id": "sold_out_url", "label": "Sold out link" },
    { "type": "text", "id": "empty_text", "label": "Empty collection text", "default": "No products in this collection yet." }
  ],
  "presets": [{ "name": "Strukt catalogue" }]
}
{% endschema %}
