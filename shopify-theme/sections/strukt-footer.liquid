{{ 'strukt.css' | asset_url | stylesheet_tag }}

<div class="strukt">
  <div class="strukt-container">
    <footer class="strukt-footer">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'brand' -%}
            <div {{ block.shopify_attributes }}>
              <p class="strukt-footer__brand">{{ block.settings.brand | default: shop.name }}</p>
              <p class="strukt-footer__tagline">{{ block.settings.tagline }}</p>
            </div>

          {%- when 'menu' -%}
            <div class="strukt-footer__col" {{ block.shopify_attributes }}>
              <span>{{ block.settings.heading }}</span>
              {%- if block.settings.menu != blank -%}
                {%- for link in block.settings.menu.links -%}
                  <a href="{{ link.url }}">{{ link.title }}</a>
                {%- endfor -%}
              {%- endif -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </footer>
  </div>
</div>

{% schema %}
{
  "name": "Strukt footer",
  "tag": "section",
  "class": "strukt-section-footer",
  "max_blocks": 6,
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "brand", "label": "Wordmark", "default": "STRUKT" },
        { "type": "textarea", "id": "tagline", "label": "Tagline", "default": "Small-run garments, published openly. Seoul, since 2019." }
      ]
    },
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Strukt footer",
      "blocks": [
        { "type": "brand" },
        { "type": "menu", "settings": { "heading": "Shop" } },
        { "type": "menu", "settings": { "heading": "Help" } },
        { "type": "menu", "settings": { "heading": "Studio" } }
      ]
    }
  ]
}
{% endschema %}
