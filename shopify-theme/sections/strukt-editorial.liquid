{{ 'strukt.css' | asset_url | stylesheet_tag }}

<div class="strukt" id="{{ section.settings.anchor | default: 'editorial' | handle }}">
  <div class="strukt-topline">
    <div class="strukt-container strukt-section">
      <section class="strukt-editorial{% if section.settings.image_first %} strukt-editorial--reverse{% endif %}">
        <div>
          {%- if section.settings.kicker != blank -%}
            <span class="strukt-kicker" style="margin-bottom:12px">{{ section.settings.kicker }}</span>
          {%- endif -%}
          <h2 class="strukt-editorial__title">{{ section.settings.heading }}</h2>
          {%- if section.settings.body != blank -%}
            <p class="strukt-editorial__body">{{ section.settings.body }}</p>
          {%- endif -%}
          {%- if section.settings.button_label != blank -%}
            <a class="strukt-btn strukt-btn--ghost" href="{{ section.settings.button_url | default: '#' }}">
              {{ section.settings.button_label }}
            </a>
          {%- endif -%}
        </div>

        <figure
          class="strukt-media strukt-editorial__media{% if section.settings.grayscale %} strukt-grayscale{% endif %}"
          style="aspect-ratio: {{ section.settings.image_ratio }};"
        >
          {%- if section.settings.image != blank -%}
            {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '500,700,1000,1400', sizes: '(max-width: 899px) 92vw, 55vw' }}
          {%- else -%}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </figure>
      </section>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Strukt editorial",
  "tag": "section",
  "class": "strukt-section-editorial",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "The workshop" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Cut in Seoul, finished by hand" },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "Two cutters, one sewing floor, a fourteen-day run. We publish the fabric mill, the seam count and the unit cost of every garment — the same way we publish the price."
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Read the production notes" },
    { "type": "url", "id": "button_url", "label": "Button link" },
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "editorial" },
    { "type": "header", "content": "Image" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Aspect ratio",
      "options": [
        { "value": "951 / 665", "label": "Landscape (design default)" },
        { "value": "3 / 2", "label": "Landscape 3:2" },
        { "value": "1 / 1", "label": "Square" },
        { "value": "4 / 5", "label": "Portrait 4:5" }
      ],
      "default": "951 / 665"
    },
    { "type": "checkbox", "id": "grayscale", "label": "Grayscale treatment", "default": true },
    { "type": "checkbox", "id": "image_first", "label": "Image on the left", "default": false }
  ],
  "presets": [{ "name": "Strukt editorial" }]
}
{% endschema %}
